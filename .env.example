# --- Database ---
DATABASE_URL="file:./dev.db"

# --- Auth ---
SESSION_SECRET="hvr-dev-secret-change-me-in-production-0123456789"

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Billing ---
# "mock" = simulated checkout (no payment keys needed — local dev/demo)
# "live" = real payments (requires PayPal keys and/or a USDT wallet below)
PAYMENT_MODE="mock"
LISTING_PRICE_CENTS="500"
LISTING_DURATION_DAYS="30"
# Package prices (cents)
BASIC_PRICE_CENTS="500"
FEATURED_PRICE_CENTS="2000"
PREMIUM_PRICE_CENTS="5000"

# --- PayPal ---
# Option A (recommended, automatic): REST API credentials from developer.paypal.com
# PAYPAL_CLIENT_ID=""
# PAYPAL_CLIENT_SECRET=""
# PAYPAL_MODE="live"             # "sandbox" for testing, "live" for production
#
# Option B (manual): owners send to this PayPal email; you approve in Admin → Payments.
# Used only while the API keys above are empty.
# PAYPAL_EMAIL="you@example.com"

# --- USDT TRC20 (crypto payments straight to your wallet) ---
# USDT_TRC20_ADDRESS="T..."      # your Tron (TRC20) wallet address
# TRONGRID_API_KEY=""            # optional — free key from trongrid.io for higher limits
# Strict verification policy (defaults shown)
# TRON_MIN_CONFIRMATIONS="19"
# TRON_TX_MAX_AGE_MINUTES="30"
# USDT_RATE_LIMIT_ATTEMPTS="5"
# USDT_RATE_LIMIT_WINDOW_MINUTES="10"

# --- Email (optional; falls back to console logging) ---
# RESEND_API_KEY="re_..."
EMAIL_FROM="Hawaiian Vacation Rents <no-reply@hawaiianvacationrents.com>"

# --- Telegram instant notifications (optional) ---
# 1) In Telegram, message @BotFather → /newbot → copy the token
# 2) Message your new bot anything, then open:
#    https://api.telegram.org/bot<TOKEN>/getUpdates → copy "chat":{"id":...}
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_CHAT_ID=""

# --- Admin notifications (optional) ---
# ADMIN_EMAIL="you@example.com"  # gets an email when a PayPal payment needs review

# --- Cron protection (optional) ---
# CRON_SECRET="some-random-string"

# --- Formspree (email delivery for contact + new-property forms, optional) ---
# FORMSPREE_ENDPOINT="https://formspree.io/f/xxxxxxxx"
